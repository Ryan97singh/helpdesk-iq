# Copy to .env (never commit .env). Every value can also come from AWS Secrets Manager / K8s Secrets.

# --- LLM gateway -------------------------------------------------------------
# Primary provider: claude | openai | azure_openai | mock
LLM_PROVIDER=claude
# Tried in order if the primary fails (unconfigured providers are skipped)
LLM_FALLBACK_PROVIDERS=azure_openai,openai,mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_FAST_DEPLOYMENT=gpt-4o-mini
# Model routing (strong model for chat answers, cheap model for triage)
CHAT_MODEL_CLAUDE=claude-sonnet-5-5
FAST_MODEL_CLAUDE=claude-haiku-5-5
LLM_CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# --- Auth --------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Optional Google SSO (OAuth 2.0 / OIDC)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local dev without Docker (defaults) --------------------------------------
# DATABASE_URL=sqlite:///./helpdeskiq.db
# REDIS_URL=            (unset -> in-memory cache + in-process event worker)
# MONGO_URL=            (unset -> in-memory transcripts)
