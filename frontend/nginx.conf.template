server {
  listen 80;

  # Re-resolve the API's DNS name at runtime (containers/pods get new IPs on redeploy).
  # NGINX_RESOLVER: 127.0.0.11 under Docker; kube-dns.kube-system.svc.cluster.local in Kubernetes.
  resolver ${NGINX_RESOLVER} valid=10s;
  set $api_upstream http://${API_UPSTREAM};
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;          # stream SSE tokens immediately
    proxy_read_timeout 300s;
    client_max_body_size 11m;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback: client-side routes resolve to index.html
  location / {
    try_files $uri /index.html;
  }
}
